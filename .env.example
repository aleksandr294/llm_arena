# Copy to .env and replace placeholders. Never commit real credentials.
API_HOST=0.0.0.0
API_PORT=8000
HEALTH_CHECK_TIMEOUT_SECONDS=2.0

DATABASE_URL=postgresql+asyncpg://arena:change-me@localhost:5432/arena
RABBITMQ_URL=amqp://arena:change-me@localhost:5672/

# JWT signing. JWT_SECRET_KEY is required: at least 32 random characters, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# The placeholder below is rejected on startup. Changing it ends all sessions.
JWT_SECRET_KEY=change-me-generate-a-random-secret-key
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800
JWT_ISSUER=llm-arena

# LLM providers (optional; leave empty to disable a provider)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Max simultaneous model requests per provider in one worker process
LLM_MAX_CONCURRENCY=4

# Optional JSON pricing file for estimated costs (see docs/pricing.example.json).
# Leave empty to disable cost estimates.
PRICING_FILE=

# docker compose
POSTGRES_USER=arena
POSTGRES_PASSWORD=change-me
POSTGRES_DB=arena
RABBITMQ_DEFAULT_USER=arena
RABBITMQ_DEFAULT_PASS=change-me
