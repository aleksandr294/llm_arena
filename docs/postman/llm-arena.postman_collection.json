    {
      "key": "provider",
      "value": "openai"
    },
    {
      "key": "model",
      "value": "gpt-4o-mini"
    },
    {
      "key": "access_token",
      "value": ""
    },
    {
      "key": "refresh_token",
      "value": ""
    },
    {
      "key": "organization_id",
      "value": ""
